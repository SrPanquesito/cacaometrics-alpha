{
  "name": "cacaometrics",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cacaometrics",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/cli": {
      "name": "@cacaometrics/cli",
      "version": "0.1.0",
      "dependencies": {
        "@cacaometrics/agents": "*",
        "@cacaometrics/data": "*",
        "@cacaometrics/metrics": "*"
      },
      "bin": {
        "cacao": "src/index.js"
      }
    },
    "apps/demo": {
      "name": "@cacaometrics/demo",
      "version": "0.1.0"
    },
    "node_modules/@cacaometrics/agents": {
      "resolved": "packages/agents",
      "link": true
    },
    "node_modules/@cacaometrics/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@cacaometrics/data": {
      "resolved": "packages/data",
      "link": true
    },
    "node_modules/@cacaometrics/demo": {
      "resolved": "apps/demo",
      "link": true
    },
    "node_modules/@cacaometrics/metrics": {
      "resolved": "packages/metrics",
      "link": true
    },
    "packages/agents": {
      "name": "@cacaometrics/agents",
      "version": "0.1.0",
      "dependencies": {
        "@cacaometrics/metrics": "*"
      }
    },
    "packages/data": {
      "name": "@cacaometrics/data",
      "version": "0.1.0"
    },
    "packages/metrics": {
      "name": "@cacaometrics/metrics",
      "version": "0.1.0"
    }
  }
}
